{
  "name": "@realizah/storefront-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared storefront primitives — Medusa client factory, QueryClient, base API helpers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.13.3",
    "@tanstack/react-query": "^5.90.21"
  },
  "devDependencies": {
    "@realizah/tsconfig": "workspace:*",
    "@types/node": "^20.11.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
