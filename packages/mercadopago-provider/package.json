{
  "name": "@realizah/mercadopago-provider",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm",
    "dev": "tsup src/index.ts src/service.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@medusajs/framework": "^2.7.1",
    "@medusajs/types": "^2.7.1",
    "mercadopago": "^2.12.0"
  },
  "devDependencies": {
    "@realizah/tsconfig": "workspace:*",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.7.0",
    "@medusajs/types": "^2.7.0"
  }
}
