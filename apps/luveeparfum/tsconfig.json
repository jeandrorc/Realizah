{
  "extends": "@realizah/tsconfig/nextjs.json",
  "compilerOptions": {
    "outDir": ".next",
    "rootDir": ".",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
